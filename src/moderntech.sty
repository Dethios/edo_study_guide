% ============================
% * moderntech.sty — shared preamble utilities
% ============================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{moderntech}[2025/11/06 v1.0 ModernTech shared preamble]

\RequirePackage{moderntech-base}
\makeatletter

% =============================================================================
% LANGUAGE, DATES, AND LOCALIZATION
% =============================================================================
% Silence datatool/tracklang locale chatter (used by datetime2)
\PassOptionsToPackage{nowarn}{tracklang}

% Language & hyphenation (american as main)
\RequirePackage[main=american]{babel}

% Date handling (datetime2 integrates with babel)
\RequirePackage[datesep=~,calc]{datetime2}

% Compact display: "DD Mon YYYY"
\DTMnewdatestyle{mydateformat}{%
  \RenewDocumentCommand{\DTMdisplaydate}{m m m m}{%
    \DTMtwodigits{##3}~\DTMshortmonthname{##2}~\number##1%
  }%
}

% =============================================================================
% GRAPHICS AND UTILITIES
% =============================================================================
\RequirePackage{graphicx}
\RequirePackage[export]{adjustbox}   % e.g., \includegraphics[width=\linewidth,frame]
\RequirePackage{grffile}
\DeclareGraphicsRule{.jfif}{jpg}{.jfif}{}
\RequirePackage[mode=buildnew]{standalone}
\RequirePackage{subfiles}
\@ifclassloaded{subfiles}{\MTSubfilestrue}{\MTSubfilesfalse}
\providecommand{\IfSubfilesClassLoaded}[2]{%
  \ifMTSubfiles
    #1%
  \else
    #2%
  \fi
}
\RequirePackage{xstring}

% Graphics search paths for main + subfile contexts (root, src/, chapters/).
\graphicspath{%
  {\subfix{assets/images/}}%
  {\subfix{../assets/images/}}%
  {\subfix{../../assets/images/}}%
  {\subfix{assets/information/}}%
  {\subfix{../assets/information/}}%
  {\subfix{../../assets/information/}}%
  {\subfix{src/tikz/}}%
  {\subfix{tikz/}}%
  {\subfix{../tikz/}}%
  {\subfix{src/tikz/out/}}%
  {\subfix{tikz/out/}}%
  {\subfix{../tikz/out/}}%
}

% =============================================================================
% HYPERREF EXTENSIONS
% =============================================================================
\PassOptionsToPackage{colorlinks=true,linktoc=all,hyperfootnotes=false}{hyperref}
\@ifpackageloaded{hyperref}{}{%
  \RequirePackage{hyperref}%
}
\RequirePackage{xurl}              % richer URL breakpoints
\RequirePackage{etoolbox}          % hooks for post-package adjustments
\Urlmuskip=0mu plus 2mu
\hypersetup{
  breaklinks=true,
  colorlinks=true,
  hypertexnames=false, % avoid duplicate anchor names misrouting links
  linkcolor=black,
  citecolor=AccentGreen,
  urlcolor=AccentBlue,
  filecolor=AccentPurple
}

\RequirePackage{xr-hyper}
\providecommand{\subfix}[1]{#1}
\NewDocumentCommand{\ImportAUX}{m}{%
  \IfFileExists{#1.aux}{\externaldocument*{#1}}{}%
}
% Pull the main document AUX into subfile builds so cross-references resolve.
\@ifundefined{IfSubfilesClassLoaded}{}{%
  \IfSubfilesClassLoaded{%
    \ImportAUX{\subfix{../../build/main}}%
  }{}%
}

\RequirePackage{bookmark}
\urlstyle{tt}

% Keep PDF metadata strings clean if color commands leak into bookmarks.
\pdfstringdefDisableCommands{
  \def\color#1{}%
  \def\textcolor#1#2{#2}%
}

% =============================================================================
% GLOSSARIES AND ACRONYMS (scrbook-friendly)
% =============================================================================
\RequirePackage[
  stylemods=all,
  acronym,
  nonumberlist,
  nogroupskip,
  nopostdot,
  toc             % add entries to the Table of Contents (KOMA-friendly)
]{glossaries-extra}

\setabbreviationstyle[acronym]{long-short}

% --- Build mode: no external indexing (fast, good for continuous writing) ---
% Kill auto "smart space" in old glossaries/glossaries-extra
\@ifundefined{gls@autospacingfalse}{}{%
  \gls@autospacingfalse % old/new releases that have the flag
}%
% In older releases, \glsdoautoinsert performs the lookahead; neutralize it.
\@ifundefined{glsdoautoinsert}{}{%
  \let\glsdoautoinsert\@gobble % swallow its argument(s) and do nothing
}%
% Ensure the final space emitter does nothing.
\@ifundefined{gls@insertspace}{}{%
  \renewcommand*{\gls@insertspace}{}%
}%

% --- Load your acronym definitions ------------------------------------------
\loadglsentries{acronyms.def}
\makenoidxglossaries

% =========================
% Hyperlinked, no-space acronyms
% =========================
% Shared helpers for linked acronym output and smart spacing
\DeclareRobustCommand{\silentglsadd}[1]{%
  \@bsphack
  \glsadd{#1}%
  \@esphack
  \futurelet\@let@token\silentglsadd@i
}
\def\silentglsadd@i{%
  \ifx\@let@token\space
    \expandafter\silentglsadd@gobble
  \else
    \ignorespaces
  \fi
}
\def\silentglsadd@gobble#1{}%

\NewDocumentCommand{\edoAcrLink}{m m}{\hyperlink{glo:#1}{#2}}%
  \AtBeginDocument{\let\@gls@adjustmode\@empty}%
\NewDocumentCommand{\edoAcrRender}{m m m m}{%
  \IfBooleanTF{#1}{%
    \edoAcrLink{#2}{#3{#2}}%
  }{%
    \ifglsused{#2}{%
      \edoAcrLink{#2}{#3{#2}}%
    }{%
      \edoAcrLink{#2}{#4{#2}\silentglsadd{#2}(#3{#2})}\glsunset{#2}%
    }%
  }%
}%

% \ac{<lab>}  : first use -> long (SHORT), later -> SHORT; linked; usage tracked
% \ac*{<lab>} : always SHORT; linked; no usage change
\NewDocumentCommand{\ac}{s m}{%
  \edoAcrRender{#1}{#2}{\glsentryshort}{\glsentrylong}%
}%

% Compatibility shims for legacy shortcut macros (short forms only)
\providecommand{\acs}[1]{\glsxtrshort{#1}}%
\providecommand{\Acs}[1]{\Glsxtrshort{#1}}%
\providecommand{\acsp}[1]{\glsxtrshortpl{#1}}%
\providecommand{\Acsp}[1]{\Glsxtrshortpl{#1}}%

% Plural
\NewDocumentCommand{\acp}{s m}{%
  \edoAcrRender{#1}{#2}{\glsentryshortpl}{\glsentrylongpl}%
}%

% Capitalized variants
\NewDocumentCommand{\Ac}{s m}{%
  \edoAcrRender{#1}{#2}{\Glsentryshort}{\Glsentrylong}%
}%
\NewDocumentCommand{\Acp}{s m}{%
  \edoAcrRender{#1}{#2}{\Glsentryshortpl}{\Glsentrylongpl}%
}%

% For list labels / moving args (optional; linked)
\NewDocumentCommand{\aclabel}{m}{%
  \hyperlink{glo:#1}{\glsentryshort{#1}}%
}%

% =============================================================================
% LOW-LEVEL TWEAKS AND MACROS (reserved)
% =============================================================================
% Placeholder for future tweaks; kept to mirror prior modular preamble slot.

\makeatother
% End of package
