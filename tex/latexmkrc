# Keep PDF and aux files under the project artifact root.
use Cwd qw(abs_path);
use File::Basename qw(dirname);
use File::Path qw(make_path);

*moderntech_normalize_path = sub {
    my ($path) = @_;
    $path =~ s{\\}{/}g;
    $path =~ s{/$}{} if $path ne '/';
    return $path;
} unless defined &moderntech_normalize_path;

*moderntech_pick_writable_dir = sub {
    my ($preferred, $fallback_leaf) = @_;
    my $tmp_root = moderntech_normalize_path($ENV{'TMPDIR'} // '/tmp');
    my $fallback = moderntech_normalize_path("$tmp_root/edo_study_guide/$fallback_leaf");

    foreach my $candidate ($preferred, $fallback) {
        eval { make_path($candidate); 1 } or next;
        my $probe = "$candidate/.write-test-$$";
        if (open(my $fh, '>', $probe)) {
            close($fh);
            unlink($probe);
            return $candidate;
        }
    }

    return $fallback;
} unless defined &moderntech_pick_writable_dir;

# Anchor to this rcfile's location so CWD never changes output paths.
my $root_dir = abs_path(dirname(__FILE__) . '/..');
$root_dir = moderntech_normalize_path($root_dir);

$out_dir = moderntech_pick_writable_dir("$root_dir/artifacts/out", 'out');
$aux_dir = moderntech_pick_writable_dir("$root_dir/artifacts/build", 'build');
# Stay in repo root so artifact paths resolve consistently when compiling tex/main.tex.
$do_cd = 0;

# Ensure LuaLaTeX has a writable cache dir for luaotfload/fontspec (important in
# sandboxed environments where repo-local cache trees may have stale ownership).
$ENV{'TEXMFVAR'}   = moderntech_pick_writable_dir("$aux_dir/texmf-var/codex",   'texmf-var');
$ENV{'TEXMFCACHE'} = moderntech_pick_writable_dir("$aux_dir/texmf-cache/codex", 'texmf-cache');
make_path($ENV{'TEXMFVAR'});
make_path($ENV{'TEXMFCACHE'});

# TikZ externalization cache: keep generated figures under the project artifact
# root by default. Build wrappers may still override these paths explicitly.
my $default_tikz_dir = moderntech_normalize_path("$root_dir/artifacts/tikz");
$ENV{'MODERNTECH_TIKZ_EXTERNAL_PRIMARY'} = moderntech_normalize_path($ENV{'MODERNTECH_TIKZ_EXTERNAL_PRIMARY'} // $default_tikz_dir);
$ENV{'MODERNTECH_TIKZ_EXTERNAL_FALLBACK'} = moderntech_normalize_path($ENV{'MODERNTECH_TIKZ_EXTERNAL_FALLBACK'} // $default_tikz_dir);
make_path($ENV{'MODERNTECH_TIKZ_EXTERNAL_PRIMARY'});
make_path($ENV{'MODERNTECH_TIKZ_EXTERNAL_FALLBACK'});

# Ensure LaTeX can see tex/ sources even when latexmk is run from elsewhere.
# Keep search paths shallow to avoid picking up stale aux files.
my $path_sep = ($^O =~ /mswin32|cygwin|msys/i) ? ';' : ':';
$ENV{'TEXINPUTS'} = "$root_dir/tex$path_sep" . ($ENV{'TEXINPUTS'} // '');
$ENV{'BIBINPUTS'} = "$root_dir/tex$path_sep" . ($ENV{'BIBINPUTS'} // '');
$ENV{'BSTINPUTS'} = "$root_dir/tex$path_sep" . ($ENV{'BSTINPUTS'} // '');
$ENV{'TEXMFCNF'} = "$root_dir$path_sep$root_dir/tex$path_sep$root_dir/texmf-dist$path_sep" . ($ENV{'TEXMFCNF'} // '');

# Allow TikZ externalization writes under artifact paths in trusted builds.
$ENV{'openout_any'} = 'a';

# Glossaries
add_cus_dep('glo','gls',0,'makeglossaries');
*makeglossaries = sub { system("makeglossaries \"$_[0]\""); } unless defined &makeglossaries;

