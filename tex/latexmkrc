# Keep PDF in repo; put aux where LaTeX/biber agree.
use Cwd qw(abs_path);
use File::Basename qw(dirname);
use File::Path qw(make_path);

*moderntech_normalize_path = sub {
    my ($path) = @_;
    $path =~ s{\\}{/}g;
    $path =~ s{/$}{} if $path ne '/';
    return $path;
} unless defined &moderntech_normalize_path;

# Anchor to this rcfile's location so CWD never changes output paths.
my $root_dir = abs_path(dirname(__FILE__) . '/..');
my $null_device = ($^O =~ /mswin32|cygwin|msys/i) ? 'NUL' : '/dev/null';
my $super_dir = qx(git -C "$root_dir" rev-parse --show-superproject-working-tree 2>$null_device);
chomp $super_dir;
my $workspace_dir = $super_dir ne '' ? abs_path($super_dir) : $root_dir;

$root_dir = moderntech_normalize_path($root_dir);
$workspace_dir = moderntech_normalize_path($workspace_dir);

$out_dir = "$root_dir/out";
$aux_dir = "$root_dir/build";
# Stay in repo root so out/build resolve consistently when compiling tex/main.tex.
$do_cd = 0;

# Ensure LuaLaTeX has a writable cache dir for luaotfload/fontspec (important in
# sandboxed environments where $HOME may not be writeable).
$ENV{'TEXMFVAR'}   = "$aux_dir/texmf-var";
$ENV{'TEXMFCACHE'} = "$aux_dir/texmf-cache";
make_path($ENV{'TEXMFVAR'});
make_path($ENV{'TEXMFCACHE'});

# TikZ externalization cache: prefer workspace-level hidden cache, fallback to
# non-hidden workspace build cache when openout policies block hidden writes.
$ENV{'MODERNTECH_TIKZ_EXTERNAL_PRIMARY'} = moderntech_normalize_path("$workspace_dir/.build/tikz");
$ENV{'MODERNTECH_TIKZ_EXTERNAL_FALLBACK'} = moderntech_normalize_path("$workspace_dir/build/tikz");
make_path($ENV{'MODERNTECH_TIKZ_EXTERNAL_PRIMARY'});
make_path($ENV{'MODERNTECH_TIKZ_EXTERNAL_FALLBACK'});

# Ensure LaTeX can see tex/ sources even when latexmk is run from elsewhere.
# Keep search paths shallow to avoid picking up stale aux files.
my $texinputs_sep = ($^O =~ /mswin32|cygwin|msys/i) ? ';' : ':';
$ENV{'TEXINPUTS'} = "$root_dir/tex$texinputs_sep" . ($ENV{'TEXINPUTS'} // '');
$ENV{'BIBINPUTS'} = "$root_dir/tex$texinputs_sep" . ($ENV{'BIBINPUTS'} // '');
$ENV{'BSTINPUTS'} = "$root_dir/tex$texinputs_sep" . ($ENV{'BSTINPUTS'} // '');
$ENV{'TEXMFCNF'} = "$root_dir:$root_dir/tex:$root_dir/texmf-dist:" . ($ENV{'TEXMFCNF'} // '');

# Allow TikZ externalization writes under .build/ (hidden path) in trusted builds.
$ENV{'openout_any'} = 'a';

# Tell latexmk this is a LuaLaTeX workflow
$pdf_mode = 4;
# Silence previewer in -pvc/-view modes (no acroread/xdg-open).
$pdf_previewer = 'none';

# Enable shell-escape, synctex, etc.
# $force_mode   = 1;
$shell_escape = 1;
$synctex      = 1;
$interaction  = 'nonstopmode';
$pvc_timeout  = 600;

# Engine commands used by latexmk. Keep shell-escape enabled for trusted builds
# that use TikZ externalization, and let latexmk supply engine-specific out/aux
# flags so the rc works on both MiKTeX and TeX Live.
$lualatex = 'lualatex -shell-escape -file-line-error -synctex=1 -interaction=nonstopmode %O %S';
$pdflatex = 'pdflatex -shell-escape -interaction=nonstopmode %O %S';
# In this repo, -lualatex is the primary mode; map latex runs to lualatex.
$pdflatex = $lualatex if $pdf_mode == 4;

# Glossaries
add_cus_dep('glo','gls',0,'makeglossaries');
*makeglossaries = sub { system("makeglossaries \"$_[0]\""); } unless defined &makeglossaries;

# Force biber to read/write the aux dir
$bibtex = "biber --input-directory=\"$aux_dir\" --output-directory=\"$aux_dir\" %O %B";
$biber = "biber --input-directory=\"$aux_dir\" --output-directory=\"$aux_dir\" %O %B";
