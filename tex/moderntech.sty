% =============================================================================
% HYPERREF EXTENSIONS
% =============================================================================
\PassOptionsToPackage{colorlinks=true,linktoc=all,hyperfootnotes=false}{hyperref}
\@ifpackageloaded{hyperref}{}{%
    \RequirePackage{hyperref}%
}
\RequirePackage{xurl}              % richer URL breakpoints
\RequirePackage{etoolbox}          % hooks for post-package adjustments
\Urlmuskip=0mu plus 2mu
\hypersetup{
    breaklinks=true,
    colorlinks=true,
    hypertexnames=false, % avoid duplicate anchor names misrouting links
    linkcolor=BlueDeep,
    citecolor=Green,
    urlcolor=Blue,
    filecolor=SteelGray
}

\RequirePackage{xr-hyper}
\providecommand{\subfix}[1]{#1}
\NewDocumentCommand{\ImportAUX}{m}{%
    \IfFileExists{#1.aux}{\externaldocument*{#1}}{}%
}

\RequirePackage{bookmark}
\urlstyle{tt}

% Keep PDF metadata strings clean if color commands leak into bookmarks.
\pdfstringdefDisableCommands{
    \def\color#1{}%
    \def\textcolor#1#2{#2}%
}

% =============================================================================
% GLOSSARIES AND ACRONYMS (scrbook-friendly)
% =============================================================================
\RequirePackage[
    stylemods=all,
    acronym,
    nonumberlist,
    nogroupskip,
%   shortcuts=ac, % Revert to 'ac' for shortcuts
    nopostdot,
    toc             % add entries to the Table of Contents (KOMA-friendly)
]{glossaries-extra}

\setabbreviationstyle[acronym]{long-short}

% --- Build mode: no external indexing (fast, good for continuous writing) ---
% Kill auto "smart space" in old glossaries/glossaries-extra
\@ifundefined{gls@autospacingfalse}{}{%
    \gls@autospacingfalse % old/new releases that have the flag
}%
% In older releases, \glsdoautoinsert performs the lookahead; neutralize it.
\@ifundefined{glsdoautoinsert}{}{%
    \let\glsdoautoinsert\@gobble % swallow its argument(s) and do nothing
}%
% Ensure the final space emitter does nothing.
\@ifundefined{gls@insertspace}{}{%
    \renewcommand*{\gls@insertspace}{}%
}%
\@ifundefined{glsxtrfullsep}{}{\renewcommand*{\glsxtrfullsep}[1]{}}%
% Keep noidx write side-effects, but execute write payload in a throwaway box
% so it doesn't inject a visible leading interword glue node in \gls output.
\AtBeginDocument{%
    \@ifundefined{glsencapwrcontent}{}{%
        \renewcommand*{\glsencapwrcontent}[1]{\setbox\z@=\hbox{$\m@th\null$#1}}%
    }%
}
% NOTE: glossaries-extra emits a stray leading space in \glslink; avoid it.
% We link via \@glslink and manually add glossary usage.
\@ifundefined{@gls@link}{}{%
    \patchcmd{\@gls@link}{\leavevmode }{\leavevmode}{}{}%
}
% Guard plain \gls path on older/variant internals by bypassing \@glo@text
% indirection (which may carry a trailing space token in some variants).
\@ifundefined{@gls@}{}{%
    \patchcmd{\@gls@}
    {\@gls@link[#1]{#2}{\@glo@text}}
    {\@gls@link[#1]{#2}{\csname gls@\glstype @entryfmt\endcsname}}
    {}{}%
}

% --- Load your acronym definitions ------------------------------------------
\loadglsentries{acronyms.def}
\makenoidxglossaries
\providecommand*{\GlsNoIdxDoRerunCheck}{}%
\renewcommand*{\GlsNoIdxDoRerunCheck}{}
% Fallbacks for noidx writes when glossaries doesn't set counters yet.
\providecommand*{\theglsentrycounter}{\thepage}
\providecommand*{\theHglsentrycounter}{\thepage}

% =========================
% Hyperlinked, no-space acronyms
% =========================
% Shared helpers for linked acronym output and smart spacing
\DeclareRobustCommand{\silentglsadd}[1]{\begingroup\setbox\z@=\hbox{\glsadd{#1}}\endgroup}%

\DeclareDocumentCommand{\edoAcrLink}{m m}{%
\@ifundefined{@glslink}{\@ifundefined{glslink}{#2}{\glslink{#1}{#2}}}{\@glslink{\glolinkprefix\glsdetoklabel{#1}}{#2}}%
}%
% Guard against legacy/variant wrappers that may leak leading/trailing space
% tokens in acronym short forms. Keep output stable as [DoW], not [ DoW ].
\DeclareDocumentCommand{\edoAcrShortFmt}{m}{\ignorespaces\glsentryshort{#1}\unskip}%
\DeclareDocumentCommand{\edoAcrShortPlFmt}{m}{\ignorespaces\glsentryshortpl{#1}\unskip}%
\DeclareDocumentCommand{\edoAcrShortCapFmt}{m}{\ignorespaces\Glsentryshort{#1}\unskip}%
\DeclareDocumentCommand{\edoAcrShortPlCapFmt}{m}{\ignorespaces\Glsentryshortpl{#1}\unskip}%
\AtBeginDocument{\let\@gls@adjustmode\@empty}%
\NewDocumentCommand{\edoAcrRender}{m m m m}{%
    \IfBooleanTF{#1}{%
        \edoAcrLink{#2}{#3{#2}}%
    }{%
        \ifglsused{#2}{%
            \edoAcrLink{#2}{#3{#2}}%
        }{%
            \silentglsadd{#2}%
            \edoAcrLink{#2}{#4{#2}~(#3{#2})}%
            \glsunset{#2}%
        }%
    }%
}%

% \ac{<lab>}  : first use -> long (SHORT), later -> SHORT; linked; usage tracked
% \ac*{<lab>} : always SHORT; linked; no usage change
\DeclareDocumentCommand{\ac}{s m}{\edoAcrRender{#1}{#2}{\edoAcrShortFmt}{\glsentrylong}}%

% Compatibility shims for legacy shortcut macros (short forms only)
\providecommand{\acs}[1]{\glsxtrshort{#1}}%
\providecommand{\Acs}[1]{\Glsxtrshort{#1}}%
\providecommand{\acsp}[1]{\glsxtrshortpl{#1}}%
\providecommand{\Acsp}[1]{\Glsxtrshortpl{#1}}%

% Plural
\DeclareDocumentCommand{\acp}{s m}{\edoAcrRender{#1}{#2}{\edoAcrShortPlFmt}{\glsentrylongpl}}%

% Capitalized variants
\DeclareDocumentCommand{\Ac}{s m}{\edoAcrRender{#1}{#2}{\edoAcrShortCapFmt}{\Glsentrylong}}%
\DeclareDocumentCommand{\Acp}{s m}{\edoAcrRender{#1}{#2}{\edoAcrShortPlCapFmt}{\Glsentrylongpl}}%

% For list labels / moving args (optional; linked)
\NewDocumentCommand{\aclabel}{m}{\hyperlink{glo:#1}{\glsentryshort{#1}}}%

