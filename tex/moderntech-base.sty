% =============================
% * Auto-label numbered divisions
% =============================
\newif\ifMTSubfiles
\NewDocumentCommand{\mt@ifsubfiles}{m m}{%
  \ifMTSubfiles #1\else #2\fi
}

\let\moderntech@origchapter\chapter
\RenewDocumentCommand{\chapter}{s o m}{%
  \IfBooleanTF{#1}{%
    \IfNoValueTF{#2}{\moderntech@origchapter*{#3}}{\moderntech@origchapter*[#2]{#3}}%
  }{%
    \IfNoValueTF{#2}{\moderntech@origchapter{#3}}{\moderntech@origchapter[#2]{#3}}%
    \if@mainmatter
      \mt@ifsubfiles{\label{chap:\jobname:\thechapter}}{\label{chap:\thechapter}}%
    \fi
  }%
}

\let\moderntech@origsection\section
\RenewDocumentCommand{\section}{s o m}{%
  \IfBooleanTF{#1}{%
    \IfNoValueTF{#2}{\moderntech@origsection*{#3}}{\moderntech@origsection*[#2]{#3}}%
  }{%
    \IfNoValueTF{#2}{\moderntech@origsection{#3}}{\moderntech@origsection[#2]{#3}}%
    \mt@ifsubfiles{\label{sec:\jobname:\thesection}}{\label{sec:\thesection}}%
  }%
}

\let\moderntech@origsubsection\subsection
\RenewDocumentCommand{\subsection}{s o m}{%
  \IfBooleanTF{#1}{%
    \IfNoValueTF{#2}{\moderntech@origsubsection*{#3}}{\moderntech@origsubsection*[#2]{#3}}%
  }{%
    \IfNoValueTF{#2}{\moderntech@origsubsection{#3}}{\moderntech@origsubsection[#2]{#3}}%
    \mt@ifsubfiles{\label{subsec:\jobname:\thesubsection}}{\label{subsec:\thesubsection}}%
  }%
}

\newcounter{moderntech@subsublabel}[subsection]
\let\moderntech@origsubsubsection\subsubsection
\RenewDocumentCommand{\subsubsection}{s o m}{%
  \IfBooleanTF{#1}{%
    \IfNoValueTF{#2}{\moderntech@origsubsubsection*{#3}}{\moderntech@origsubsubsection*[#2]{#3}}%
  }{%
    \IfNoValueTF{#2}{\moderntech@origsubsubsection{#3}}{\moderntech@origsubsubsection[#2]{#3}}%
    \ifnum\value{secnumdepth}<3\relax
      \stepcounter{moderntech@subsublabel}%
      \edef\moderntech@subsublabelname{\thesubsection.\arabic{moderntech@subsublabel}}%
    \else
      \edef\moderntech@subsublabelname{\thesubsubsection}%
    \fi
    \mt@ifsubfiles{\label{subsubsec:\jobname:\moderntech@subsublabelname}}{\label{subsubsec:\moderntech@subsublabelname}}%
  }%
}

