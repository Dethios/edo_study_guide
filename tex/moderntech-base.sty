  \NewDocumentCommand{\tabCite}{m}{\citetitle{#1},~\citeyear{#1}~\autocite{#1}}
\fi

\ifmoderntech@ieeebib
  \ExecuteBibliographyOptions{seconds=true}
  \AtBeginDocument{%
    \DeclareFieldFormat{labelnumber}{\mkbibhyperref{#1}}%
    \DeclareFieldFormat{shorthand}{\mkbibhyperref{#1}}%
  }%
  \AtBeginDocument{\let\blx@warn@bibempty\relax}
\fi

% -- Custom biblatex driver: legislation -------------------------------------
\AtBeginDocument{%
  \@ifpackageloaded{biblatex}{%
    \DeclareFieldFormat[legislation]{title}{#1}%
    \DeclareFieldFormat[legislation]{subtitle}{#1}%
    \DeclareFieldFormat[legislation]{jurisdiction}{\mkbibacro{#1}}%
    \DeclareFieldFormat[legislation]{type}{#1}%
    \DeclareFieldFormat[legislation]{number}{#1}%
    \DeclareBibliographyDriver{legislation}{%
      \usebibmacro{bibindex}%
      \usebibmacro{begentry}%
      \usebibmacro{title}%
      \newunit
      \printfield{type}%
      \setunit*{\addspace}%
      \printfield{number}%
      \newunit
      \printfield{jurisdiction}%
      \newunit
      \usebibmacro{date}%
      \newunit
      \printfield{note}%
      \newunit\newblock
      \usebibmacro{doi+eprint+url}%
      \newunit\newblock
      \usebibmacro{addendum+pubstate}%
      \setunit{\bibpagerefpunct}\newblock
      \usebibmacro{pageref}%
      \newunit\newblock
      \iftoggle{bbx:related}{\usebibmacro{related:init}\usebibmacro{related}}{}%
      \usebibmacro{finentry}%
    }%
  }{}%
}

