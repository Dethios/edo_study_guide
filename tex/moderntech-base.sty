% =============================
\ifmoderntech@ieeebib
\RequirePackage[backend=biber,style=ieee,defernumbers=true,sorting=none,hyperref=false,backref=false]{biblatex}
  \IfFileExists{\moderntech@bibresource}{}{%
    \IfFileExists{bib/\moderntech@bibresource}{%
      \renewcommand{\moderntech@bibresource}{bib/\moderntech@bibresource}%
    }{}%
  }%
  \addbibresource{\moderntech@bibresource}
  \NewDocumentCommand{\nbcite}{m}{\citeauthor{#1}~\autocite{#1}}
