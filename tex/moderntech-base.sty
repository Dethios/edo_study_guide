\dblfloatplacement{figure}{htbp}%
\captionsetup[figure]{position=below}
\captionsetup[table]{position=above}

% =============================
% * Roman table numbering + no chapter reset (optional)
% =============================
\ifmoderntech@tablesroman
  \RequirePackage{chngcntr}
  \@ifundefined{c@chapter}{}{%
    \counterwithout{table}{chapter}%
  }%
  \renewcommand{\thetable}{\Roman{table}}
\fi

% =============================
% * Code environments (minted/listings)
% =============================
% Portable shell-escape detection (pdfTeX/LuaTeX/XeTeX)
\newif\ifmt@shellescape
\begingroup
  \ifcsname shellescape\endcsname
    \ifnum\shellescape>0\relax \global\mt@shellescapetrue \else \global\mt@shellescapefalse \fi
  \else
    \ifcsname pdfshellescape\endcsname
      \ifnum\pdfshellescape>0\relax \global\mt@shellescapetrue \else \global\mt@shellescapefalse \fi
    \else
      \ifdefined\directlua
        \ifnum\directlua{tex.print(status.shell_escape or 0)} > 0\relax
          \global\mt@shellescapetrue
        \else
          \global\mt@shellescapefalse
        \fi
      \else
        \global\mt@shellescapefalse
      \fi
    \fi
  \fi
\endgroup

\NewDocumentCommand{\moderntech@enableminted}{}{%
  \RequirePackage[cache=false]{minted}%
  \setminted{fontsize=\footnotesize, breaklines, autogobble, bgcolor=codebg}%
  \NewDocumentCommand{\code}{m}{\mintinline{text}{##1}}%
}

\NewDocumentCommand{\moderntech@enablelistings}{}{%
  \RequirePackage{listings}%
  \lstset{
    basicstyle=\ttfamily\footnotesize,
    backgroundcolor=\color{Vapor},
    showstringspaces=false,
    breaklines=true,
    frame=single,
    rulecolor=\color{Vapor},
    keywordstyle=\color{Blue}\bfseries,
    commentstyle=\color{Green}\itshape,
    stringstyle=\color{SteelGray},
    numberstyle=\tiny,
    numbers=left,
    stepnumber=1,
    numbersep=5pt,
    tabsize=2,
    captionpos=b,
    escapeinside={(*@}{@*)}
  }%
  \NewDocumentCommand{\code}{m}{\lstinline!##1!}%
}

\NewDocumentCommand{\moderntech@setupcode}{}{%
  \ifmoderntech@minted
    \IfFileExists{minted.sty}{%
      \ifmt@shellescape
        \moderntech@enableminted
      \else
        \PackageWarning{moderntech-base}{minted requested but shell-escape is disabled; using listings instead}%
        \moderntech@mintedfalse
      \fi
    }{%
      \PackageWarning{moderntech-base}{minted.sty not found; using listings instead}%
      \moderntech@mintedfalse
    }%
  \fi
  \ifmoderntech@minted
    % minted ready; no fallback
  \else
    \moderntech@enablelistings
  \fi
}
\moderntech@setupcode

% Microtype: disable inside code/verbatim blocks to avoid spacing artifacts
\@ifpackageloaded{microtype}{%
  \AtBeginEnvironment{verbatim}{\microtypesetup{activate=false}}%
  \AtEndEnvironment{verbatim}{\microtypesetup{activate=true}}%
  \@ifpackageloaded{minted}{%
    \AtBeginEnvironment{minted}{\microtypesetup{activate=false}}%
    \AtEndEnvironment{minted}{\microtypesetup{activate=true}}%
  }{}%
  \@ifpackageloaded{listings}{%
    \AtBeginEnvironment{lstlisting}{\microtypesetup{activate=false}}%
    \AtEndEnvironment{lstlisting}{\microtypesetup{activate=true}}%
  }{}%
}{}%

\RequirePackage{csquotes}

% =============================
% * Per-environment color boxes (notes, hints, warnings, info)
% =============================
\tcbset{
  sharp corners,
  boxsep=4pt, left=6pt, right=6pt, top=6pt, bottom=6pt,
  colback=Vapor, colframe=Nimbus, coltitle=BodyText,
  fonttitle=\sffamily\bfseries
}
\newtcolorbox{noteBox}[1][]{colframe=Meridian,title={\color{White}Note},#1}
\newtcolorbox{hintBox}[1][]{colframe=Blue,title={\color{White}Hint},#1}
\newtcolorbox{warnBox}[1][]{colframe=Red,title={\color{White}Warning},#1}
\newtcolorbox{infoBox}[1][]{colframe=SteelGray,title={\color{White}Info},#1}
\NewDocumentCommand{\Hint}{m}{\begin{hintBox}#1\end{hintBox}}
\NewDocumentCommand{\Note}{m}{\begin{noteBox}#1\end{noteBox}}
\NewDocumentCommand{\Warn}{m}{\begin{warnBox}#1\end{warnBox}}
\NewDocumentCommand{\Info}{m}{\begin{infoBox}#1\end{infoBox}}
\NewDocumentCommand{\hint}{m}{\Hint{#1}}
\NewDocumentCommand{\note}{m}{\Note{#1}}
\NewDocumentCommand{\warn}{m}{\Warn{#1}}
\NewDocumentCommand{\info}{m}{\Info{#1}}
\NewDocumentCommand{\tHint}{}{\textbf{\textcolor{SteelGray}{Hint}}}
\NewDocumentCommand{\tNote}{}{\textbf{\textcolor{Meridian}{Note}}}
\NewDocumentCommand{\tSource}{}{\textbf{\textcolor{Green}{Source}}}

% Tufte-style margin notes via marginnote + themed tcolorbox
\newtcolorbox{mt@sidenote}[1][]{enhanced, colback=Vapor, colframe=Blue, boxrule=.5pt,
  left=4pt, right=4pt, top=4pt, bottom=4pt, sharp corners, width=\marginparwidth, halign=left,
  fontupper=\footnotesize\sffamily\color{BodyText}, coltitle=Blue, fonttitle=\sffamily\bfseries, #1}
\NewDocumentCommand{\sidenote}{O{} m}{\marginnote{\begin{mt@sidenote}[title={#1}]#2\end{mt@sidenote}}}
\NewDocumentCommand{\sideinfo}{O{} m}{\marginnote{\begin{mt@sidenote}[title={#1},colframe=Meridian,coltitle=Meridian]#2\end{mt@sidenote}}}
\NewDocumentCommand{\sidewarn}{O{} m}{\marginnote{\begin{mt@sidenote}[title={#1},colframe=Red,coltitle=Red]#2\end{mt@sidenote}}}
\NewDocumentCommand{\sidehint}{O{} m}{\marginnote{\begin{mt@sidenote}[title={#1},colframe=SteelGray,coltitle=SteelGray]#2\end{mt@sidenote}}}

% Outer-margin placement on twoside docs
\NewDocumentCommand{\MT@outerplace}{m}{%
  \checkoddpage
  \if@twoside
    \ifoddpage\reversemarginparfalse\else\reversemarginpartrue\fi
  \else
    \reversemarginparfalse
  \fi
  #1%
}
\RenewDocumentCommand{\sidenote}{O{} m}{\MT@outerplace{\marginnote{\begin{mt@sidenote}[title={#1}]#2\end{mt@sidenote}}}}
\RenewDocumentCommand{\sideinfo}{O{} m}{\MT@outerplace{\marginnote{\begin{mt@sidenote}[title={#1},colframe=Meridian,coltitle=Meridian]#2\end{mt@sidenote}}}}
\RenewDocumentCommand{\sidewarn}{O{} m}{\MT@outerplace{\marginnote{\begin{mt@sidenote}[title={#1},colframe=Red,coltitle=Red]#2\end{mt@sidenote}}}}
\RenewDocumentCommand{\sidehint}{O{} m}{\MT@outerplace{\marginnote{\begin{mt@sidenote}[title={#1},colframe=SteelGray,coltitle=SteelGray]#2\end{mt@sidenote}}}}
\NewDocumentCommand{\MTSetupMargins}{m}{\setlength{\marginparwidth}{#1}}

% =============================
% * TikZ & Smartdiagram (theme-aligned)
% =============================
\ifmoderntech@tikzsmart
  \RequirePackage{tikz}
  \usetikzlibrary{arrows.meta,shapes,positioning,calc,fit,backgrounds}
  % --- TikZ externalization (cache figures to disk) ---
  % Requires -shell-escape in trusted builds; keep lint jobs shell-escape-free.
  % Cache artifacts are generated in one workspace-level folder:
  %   primary:  .build/tikz/
  %   fallback: build/tikz/ (for environments that block hidden output dirs)
  % Paths are supplied by build wrappers/latexmkrc via environment variables:
  %   MODERNTECH_TIKZ_EXTERNAL_PRIMARY
  %   MODERNTECH_TIKZ_EXTERNAL_FALLBACK
  % Caches can be invalidated with
  % `make force-rebuild-tikz` from the repo root.
  % Use \tikzsetnextfilename{...} to stabilize externalized artifact names.
  \usetikzlibrary{external}
  \tikzexternalize
  \providecommand{\moderntech@tikzexternalprefix}{}
  \AtBeginDocument{%
    \directlua{
      local function normalize(path)
        path = tostring(path or "")
        path = path:gsub("/+$", "")
        return path
      end

      local primary = normalize(os.getenv("MODERNTECH_TIKZ_EXTERNAL_PRIMARY"))
      local fallback = normalize(os.getenv("MODERNTECH_TIKZ_EXTERNAL_FALLBACK"))
      if primary == "" then primary = ".build/tikz" end
      if fallback == "" then fallback = "build/tikz" end

      local openout_any = ""
      if kpse and kpse.var_value then
        openout_any = string.lower(tostring(kpse.var_value("openout_any") or ""))
      end

      local hidden_path = primary:sub(1, 1) == "." or primary:find("/.", 1, true)
      local chosen = primary
      if hidden_path and not (openout_any == "a") then
        chosen = fallback
      end

      token.set_macro("moderntech@tikzexternalprefix", chosen .. "/")
    }%
    \immediate\write18{mkdir -p "\moderntech@tikzexternalprefix"}%
    \tikzsetexternalprefix{\moderntech@tikzexternalprefix}%
  }
  % LuaLaTeX worker compile; inherits shell-escape check from parent build.
  \tikzset{
    external/system call={
      lualatex --cnf-line=openout_any=a \tikzexternalcheckshellescape
      -halt-on-error -interaction=batchmode
      -jobname "\image" "\texsource"
    }
  }
  % --- end TikZ externalization ---
  \tikzset{
    every picture/.style = {>=Latex, line cap=round, line join=round},
    mt node/.style = {font=\sffamily\small\color{BodyText}, draw=Blue, rounded corners=2pt,
                      inner xsep=6pt, inner ysep=4pt, align=left},
    mt title/.style = {font=\sffamily\bfseries\color{Blue}, draw=Blue, rounded corners=3pt, fill=Blue!10, inner xsep=8pt, inner ysep=6pt, align=center},
    mt line/.style = {Blue, very thick},
    mt thin/.style = {Blue, semithick},
  }
  \tikzset{
    edo/.style = {
      font=\sffamily\small\color{BodyText},
      draw=Modern,
      rounded corners=2pt,
      inner xsep=6pt,
      inner ysep=4pt,
      align=left
    },
    edo-title/.style = {
      font=\sffamily\bfseries\color{Blue},
      draw=Modern,
      rounded corners=3pt,
      fill=Blue!12,
      inner xsep=8pt,
      inner ysep=6pt,
      align=center
    },
    edo-line/.style = {Modern, very thick},
    edo-thin/.style = {Modern, semithick},
    belowx/.style  args={#1 of #2}{below=#1 of #2},
    rightx/.style  args={#1 of #2}{right=#1 of #2},
    leftx/.style   args={#1 of #2}{left=#1 of #2},
    abovex/.style  args={#1 of #2}{above=#1 of #2},
  }
\fi
\ifmoderntech@tikzsmart
  \RequirePackage{smartdiagram}
  \smartdiagramset{
    font=\sffamily\small\color{BodyText},
    text color=BodyText,
    set color list = {Blue!45, Meridian!45, Green!45, SteelGray!35, Red!35},
  }
  \smartdiagramset{
    font=\sffamily\small\color{BodyText},
    text color=BodyText,
    set color list = {Blue!35, Meridian!40, Green!40, SteelGray!35, Red!35},
    uniform color list = Blue!30 for 10 items,
    module shape = rounded rectangle,
    module x sep = 1.6cm,
    module y sep = 1.0cm,
    module minimum width = 2.8cm,
    module minimum height = 1.0cm,
    arrow tip = Latex,
    arrow line width = 1.2pt,
    arrow color = Modern
  }
\fi

