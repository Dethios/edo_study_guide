# Normalize line endings across OSes.
* text=auto eol=lf

# Shell and PowerShell scripts should stay LF.
*.sh text eol=lf
*.ps1 text eol=lf

# Common binaries.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tif binary
*.tiff binary
*.ico binary
*.zip binary
*.7z binary
*.gz binary
*.xz binary
*.bz2 binary
*.tar binary
*.xlsx binary
*.xls binary
*.docx binary
*.pptx binary
