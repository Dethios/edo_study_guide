{
	"servers": {
		"io.github.github/github-mcp-server": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "${input:Authorization}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "0.26.3"
		},
		"io.github.upstash/context7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@upstash/context7-mcp@1.0.31"
			],
			"env": {
				"CONTEXT7_API_KEY": "${input:CONTEXT7_API_KEY}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.31"
		},
		"doist/todoist-ai": {
			"type": "http",
			"url": "https://ai.todoist.net/mcp",
			"gallery": "https://api.mcp.github.com",
			"version": "0.0.1-seed"
		},
		"com.stackoverflow.mcp/mcp": {
			"type": "http",
			"url": "https://mcp.stackoverflow.com",
			"gallery": "https://api.mcp.github.com",
			"version": "1.1.3"
		},
		"multi_reasoning": {
			"type": "stdio",
			"command": "/home/victor/dev-workspace/projects/multi_reasoning_mcp/.venv/bin/python",
			"args": [
				"-m",
				"multi_reasoning_mcp.server"
			],
			"env": {
				"PYTHONPATH": "/home/victor/dev-workspace/projects/multi_reasoning_mcp/src"
			}
		}
	},
	"inputs": [
		{
			"id": "Authorization",
			"type": "promptString",
			"description": "Authentication token (PAT or App token)",
			"password": true
		},
		{
			"id": "CONTEXT7_API_KEY",
			"type": "promptString",
			"description": "API key for authentication",
			"password": true
		}
	]
}