    "editor.guides.bracketPairsHorizontal": true,
    // editor.indentSize: Set numeric value for editor indent Size. Edit the value to change behavior.
    "editor.indentSize": 4,
    // editor.inlayHints.fontFamily: Set editor inlay Hints font Family font family. Edit the value to change behavior.
    "editor.inlayHints.fontFamily": "'Source Sans Pro'",
    // editor.inlineSuggest.enabled: Enable or disable editor inline Suggest enabled. Edit the value to change behavior.
    "editor.inlineSuggest.enabled": true,
    // editor.inlineSuggest.experimental.showOnSuggestConflict: Set editor inline Suggest experimental show On Suggest Conflict. Edit the value to change behavior.
    "editor.inlineSuggest.experimental.showOnSuggestConflict": "always",
    // editor.inlineSuggest.fontFamily: Set editor inline Suggest font Family font family. Edit the value to change behavior.
    "editor.inlineSuggest.fontFamily": "'Cascadia Code'",
    // editor.inlineSuggest.showToolbar: Set editor inline Suggest show Toolbar. Edit the value to change behavior.
    "editor.inlineSuggest.showToolbar": "onHover",
    // editor.inlineSuggest.suppressSuggestions: Enable or disable editor inline Suggest suppress Suggestions. Edit the value to change behavior.
    "editor.inlineSuggest.suppressSuggestions": true,
    // editor.inlineSuggest.triggerCommandOnProviderChange: Enable or disable editor inline Suggest trigger Command On Provider Change. Edit the value to change behavior.
    "editor.inlineSuggest.triggerCommandOnProviderChange": true,
    // editor.insertSpaces: Enable or disable editor insert Spaces. Edit the value to change behavior.
    "editor.insertSpaces": true,
    // editor.linkedEditing: Enable or disable editor linked Editing. Edit the value to change behavior.
    "editor.linkedEditing": true,
    // editor.maxTokenizationLineLength: Set numeric value for editor max Tokenization Line Length. Edit the value to change behavior.
    "editor.maxTokenizationLineLength": 200000,
    // editor.minimap.enabled: Enable or disable editor minimap enabled. Edit the value to change behavior.
    "editor.minimap.enabled": false,
    // editor.minimap.maxColumn: Set numeric value for editor minimap max Column. Edit the value to change behavior.
    "editor.minimap.maxColumn": 50,
    // editor.multiCursorPaste: Set editor multi Cursor Paste. Edit the value to change behavior.
    "editor.multiCursorPaste": "full",
    // editor.quickSuggestionsDelay: Set numeric value for editor quick Suggestions Delay. Edit the value to change behavior.
    "editor.quickSuggestionsDelay": 5,
    // editor.renderControlCharacters: Enable or disable editor render Control Characters. Edit the value to change behavior.
    "editor.renderControlCharacters": true,
