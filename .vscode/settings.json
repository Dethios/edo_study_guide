    "editor.codeActionsOnSave": {
        "source.organizeImports": "never"
    },
    // editor.codeLensFontFamily: Set editor code Lens Font Family font family. Edit the value to change behavior.
    "editor.codeLensFontFamily": "'Source Code Pro'",
    // editor.cursorBlinking: Set editor cursor Blinking. Edit the value to change behavior.
    "editor.cursorBlinking": "phase",
    // editor.cursorSmoothCaretAnimation: Set editor cursor Smooth Caret Animation. Edit the value to change behavior.
    "editor.cursorSmoothCaretAnimation": "on",
    // editor.defaultFormatter: Set editor default Formatter. Edit the value to change behavior.
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    // editor.detectIndentation: Enable or disable editor detect Indentation. Edit the value to change behavior.
    "editor.detectIndentation": false,
    // editor.dropIntoEditor.preferences: Define list for editor drop Into Editor preferences. Edit the value to change behavior.
    "editor.dropIntoEditor.preferences": [],
    // editor.fontFamily: Set editor font Family font family. Edit the value to change behavior.
    "editor.fontFamily": "'Fira Code', 'Source Code Pro', 'Cascadia Code', Consolas, 'Courier New', monospace",
    // editor.fontLigatures: Enable or disable editor font Ligatures. Edit the value to change behavior.
    "editor.fontLigatures": true,
    // editor.fontSize: Set editor font Size font size. Edit the value to change behavior.
    "editor.fontSize": 13,
    // editor.fontVariations: Enable or disable editor font Variations. Edit the value to change behavior.
    "editor.fontVariations": true,
    // editor.fontWeight: Set editor font Weight font weight. Edit the value to change behavior.
    "editor.fontWeight": "normal",
    // editor.formatOnPaste: Enable or disable editor format On Paste. Edit the value to change behavior.
    "editor.formatOnPaste": true,
    // editor.formatOnSave: Enable or disable editor format On Save. Edit the value to change behavior.
    "editor.formatOnSave": true,
    // editor.formatOnType: Enable or disable editor format On Type. Edit the value to change behavior.
    "editor.formatOnType": true,
    // editor.guides.bracketPairs: Enable or disable editor guides bracket Pairs. Edit the value to change behavior.
    "editor.guides.bracketPairs": true,
