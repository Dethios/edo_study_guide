        {
            "name": "BUILD-WIN",
            "tools": ["build-win"]
        },
        {
            "name": "BUILD-WSL",
            "tools": ["build-wsl"]
        },
        {
            "name": "BUILD-QUIET",
            "tools": ["build-quiet"]
        },
        {
            "name": "AUTO",
            "tools": ["build-wsl-watch"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "build-wsl",
            "command": "scripts/build.sh",
            "args": ["%DOC%"]
        },
        {
            "name": "build-wsl-watch",
            "command": "scripts/build.sh",
            "args": ["--watch", "%DOC%"]
        },
        {
            "name": "build-quiet",
            "command": "scripts/build.sh",
            "args": ["--quiet", "%DOC%"]
        },
        {
            "name": "build-win",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "scripts\\build.ps1",
                "%DOC%"
            ]
        }
    ],
