    "editor.renderRichScreenReaderContent": true,
    // editor.renderWhitespace: Set editor render Whitespace. Edit the value to change behavior.
    "editor.renderWhitespace": "all",
    // editor.selectionHighlightMultiline: Enable or disable editor selection Highlight Multiline. Edit the value to change behavior.
    "editor.selectionHighlightMultiline": true,
    // editor.semanticTokenColorCustomizations: Define object/map for editor semantic Token Color Customizations. Edit the value to change behavior.
    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "comment": "#7E8591",
            "function": "#8ED1E3",
            "keyword": "#8FB3D9",
            "method": "#8ED1E3",
            "number": "#F1D8A5",
            "property": "#E5E9F0",
            "string": "#A7C795",
            "type": "#94D0CC",
            "variable": "#E5E9F0"
        }
    },
    // editor.smoothScrolling: Enable or disable editor smooth Scrolling. Edit the value to change behavior.
    "editor.smoothScrolling": true,
    // editor.stickyTabStops: Enable or disable editor sticky Tab Stops. Edit the value to change behavior.
    "editor.stickyTabStops": true,
    // editor.suggest.localityBonus: Enable or disable editor suggest locality Bonus. Edit the value to change behavior.
    "editor.suggest.localityBonus": true,
    // editor.suggest.preview: Enable or disable editor suggest preview. Edit the value to change behavior.
    "editor.suggest.preview": true,
    // editor.suggest.shareSuggestSelections: Enable or disable editor suggest share Suggest Selections. Edit the value to change behavior.
    "editor.suggest.shareSuggestSelections": true,
    // editor.suggest.showDeprecated: Enable or disable editor suggest show Deprecated. Edit the value to change behavior.
    "editor.suggest.showDeprecated": false,
    // editor.suggestFontSize: Set editor suggest Font Size font size. Edit the value to change behavior.
    "editor.suggestFontSize": 12,
    // editor.suggestSelection: Set editor suggest Selection. Edit the value to change behavior.
    "editor.suggestSelection": "recentlyUsed",
    // editor.tabCompletion: Set editor tab Completion. Edit the value to change behavior.
    "editor.tabCompletion": "on",
    // editor.tabSize: Set numeric value for editor tab Size. Edit the value to change behavior.
    "editor.tabSize": 4,
    // editor.tokenColorCustomizations: Define object/map for editor token Color Customizations. Edit the value to change behavior.
    "editor.tokenColorCustomizations": {
        "comments": "#7E8591",
        "functions": "#8ED1E3",
        "keywords": "#8FB3D9",
        "numbers": "#F1D8A5",
        "strings": "#A7C795",
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "fontStyle": "italic",
                    "foreground": "#7E8591"
                }
            },
            {
                "scope": [
                    "constant.numeric",
                    "constant.language.boolean"
                ],
                "settings": {
                    "foreground": "#F1D8A5"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "foreground": "#8FB3D9"
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "support.function"
                ],
                "settings": {
                    "foreground": "#8ED1E3"
                }
            },
            {
                "scope": [
                    "string",
                    "string.quoted",
                    "string.template"
                ],
                "settings": {
                    "foreground": "#A7C795"
                }
            },
            {
                "scope": [
                    "entity.name.type",
                    "support.type",
                    "support.class"
                ],
                "settings": {
                    "foreground": "#94D0CC"
                }
            }
        ],
        "types": "#94D0CC",
        "variables": "#E5E9F0"
    },
    // editor.trimWhitespaceOnDelete: Enable or disable editor trim Whitespace On Delete. Edit the value to change behavior.
    "editor.trimWhitespaceOnDelete": true,
    // editor.unfoldOnClickAfterEndOfLine: Enable or disable editor unfold On Click After End Of Line. Edit the value to change behavior.
    "editor.unfoldOnClickAfterEndOfLine": true,
    // editor.unusualLineTerminators: Set editor unusual Line Terminators. Edit the value to change behavior.
    "editor.unusualLineTerminators": "auto",
    // editor.wordBasedSuggestions: Set editor word Based Suggestions. Edit the value to change behavior.
    "editor.wordBasedSuggestions": "allDocuments",
    // editor.wordWrap: Set editor word Wrap. Edit the value to change behavior.
    "editor.wordWrap": "on",
    // editor.wordWrapColumn: Set numeric value for editor word Wrap Column. Edit the value to change behavior.
    "editor.wordWrapColumn": 100,
    // editor.wrapOnEscapedLineFeeds: Enable or disable editor wrap On Escaped Line Feeds. Edit the value to change behavior.
    "editor.wrapOnEscapedLineFeeds": true,
    // editor.wrappingIndent: Set editor wrapping Indent. Edit the value to change behavior.
    "editor.wrappingIndent": "indent",
    // editor.wrappingStrategy: Set editor wrapping Strategy. Edit the value to change behavior.
    "editor.wrappingStrategy": "advanced",

    // ===================================================================
    // Files - File handling, auto-save, and excludes.
    // ===================================================================
    // files.associations: Define object/map for files associations. Edit the value to change behavior.
    "files.associations": {
        "*.json": "jsonc"
    },
    // files.autoGuessEncoding: Enable or disable files auto Guess Encoding. Edit the value to change behavior.
    "files.autoGuessEncoding": true,
    // files.autoSave: Set files auto Save. Edit the value to change behavior.
    "files.autoSave": "afterDelay",
    // files.autoSaveDelay: Set numeric value for files auto Save Delay. Edit the value to change behavior.
    "files.autoSaveDelay": 1000,
    // files.enableTrash: Enable or disable files enable Trash. Edit the value to change behavior.
    "files.enableTrash": false,
    // files.insertFinalNewline: Enable or disable files insert Final Newline. Edit the value to change behavior.
    "files.insertFinalNewline": true,
    // files.readonlyFromPermissions: Enable or disable files readonly From Permissions. Edit the value to change behavior.
    "files.readonlyFromPermissions": true,
    // files.simpleDialog.enable: Enable or disable files simple Dialog enable. Edit the value to change behavior.
    "files.simpleDialog.enable": true,
    // files.trimFinalNewlines: Enable or disable files trim Final Newlines. Edit the value to change behavior.
    "files.trimFinalNewlines": true,
    // files.trimTrailingWhitespace: Enable or disable files trim Trailing Whitespace. Edit the value to change behavior.
    "files.trimTrailingWhitespace": true,
    // files.watcherExclude: Define object/map for files watcher Exclude. Edit the value to change behavior.
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/.texlive202*/**": true,
        "**/build/**": true,
        "**/node_modules/**": true,
        "**/out/**": true
    },

