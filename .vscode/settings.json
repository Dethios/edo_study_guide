    // ===================================================================
    // Window - Window and workspace startup behavior.
    // ===================================================================
    // window.newWindowProfile: Set window new Window Profile. Edit the value to change behavior.
    "window.newWindowProfile": "Default",
    // window.openFoldersInNewWindow: Set window open Folders In New Window. Edit the value to change behavior.
    "window.openFoldersInNewWindow": "off",
    // window.systemColorTheme: Set the UI color theme. Edit the value to change behavior.
    "window.systemColorTheme": "dark",

    // ===================================================================
    // Editor - Editor behavior, formatting, and suggestions.
    // ===================================================================
    // diffEditor.codeLens: Enable or disable diff Editor code Lens. Edit the value to change behavior.
    "diffEditor.codeLens": true,
    // diffEditor.experimental.showMoves: Enable or disable diff Editor experimental show Moves. Edit the value to change behavior.
    "diffEditor.experimental.showMoves": true,
    // diffEditor.experimental.useTrueInlineView: Enable or disable diff Editor experimental use True Inline View. Edit the value to change behavior.
    "diffEditor.experimental.useTrueInlineView": true,
    // diffEditor.hideUnchangedRegions.enabled: Enable or disable diff Editor hide Unchanged Regions enabled. Edit the value to change behavior.
    "diffEditor.hideUnchangedRegions.enabled": true,
    // diffEditor.ignoreTrimWhitespace: Enable or disable diff Editor ignore Trim Whitespace. Edit the value to change behavior.
    "diffEditor.ignoreTrimWhitespace": true,
    // diffEditor.renderSideBySide: Enable or disable diff Editor render Side By Side. Edit the value to change behavior.
    "diffEditor.renderSideBySide": false,
    // diffEditor.wordWrap: Set diff Editor word Wrap. Edit the value to change behavior.
    "diffEditor.wordWrap": "on",
    // editor.acceptSuggestionOnEnter: Set editor accept Suggestion On Enter. Edit the value to change behavior.
    "editor.acceptSuggestionOnEnter": "smart",
    // editor.aiStats.enabled: Enable or disable editor ai Stats enabled. Edit the value to change behavior.
    "editor.aiStats.enabled": true,
    // editor.allowVariableFontsInAccessibilityMode: Enable or disable editor allow Variable Fonts In Accessibility Mode. Edit the value to change behavior.
    "editor.allowVariableFontsInAccessibilityMode": true,
    // editor.autoClosingBrackets: Set editor auto Closing Brackets. Edit the value to change behavior.
    "editor.autoClosingBrackets": "always",
    // editor.autoClosingComments: Set editor auto Closing Comments. Edit the value to change behavior.
    "editor.autoClosingComments": "always",
    // editor.autoClosingDelete: Set editor auto Closing Delete. Edit the value to change behavior.
    "editor.autoClosingDelete": "always",
    // editor.autoClosingOvertype: Set editor auto Closing Overtype. Edit the value to change behavior.
    "editor.autoClosingOvertype": "always",
    // editor.autoClosingQuotes: Set editor auto Closing Quotes. Edit the value to change behavior.
    "editor.autoClosingQuotes": "always",
    // editor.autoIndentOnPaste: Enable or disable editor auto Indent On Paste. Edit the value to change behavior.
    "editor.autoIndentOnPaste": true,
    // editor.bracketPairColorization.independentColorPoolPerBracketType: Enable or disable editor bracket Pair Colorization independent Color Pool Per Bracket Type. Edit the value to change behavior.
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
