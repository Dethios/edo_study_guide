{
    // ===================================================================
    // VS Code Tasks Configuration
    // ===================================================================
    "version": "2.0.0",
    "tasks": [
        // ---------------------------------------------------------------
        // Safe Git auto-push and AI context bundle (workspace tools)
        // ---------------------------------------------------------------
        {
            "label": "Git: Push (safe auto)",
            "type": "shell",
            "command": "${workspaceFolder:workspace}/tools/scripts/push.sh --root ${workspaceFolder} && ${workspaceFolder:workspace}/tools/scripts/ai-context.sh --root ${workspaceFolder} && ${workspaceFolder:workspace}/tools/scripts/scrub.sh --root ${workspaceFolder}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "pwsh",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-Command",
                    "& '${workspaceFolder:workspace}\\tools\\scripts\\push.ps1' --root '${workspaceFolder}'; & '${workspaceFolder:workspace}\\tools\\scripts\\ai-context.ps1' -Root '${workspaceFolder}'; & '${workspaceFolder:workspace}\\tools\\scripts\\scrub.ps1' -Root '${workspaceFolder}'"
                ]
            }
        },

        // ---------------------------------------------------------------
        // Scrub SAVE-ERROR/temp/lock artifacts
        // ---------------------------------------------------------------
        {
            "label": "Scrub temp artifacts",
            "type": "shell",
            "command": "${workspaceFolder:workspace}/tools/scripts/scrub.sh --root ${workspaceFolder}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "pwsh",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder:workspace}\\tools\\scripts\\scrub.ps1",
                    "-Root",
                    "${workspaceFolder}"
                ]
            }
        },

        // ---------------------------------------------------------------
        // AI context bundle (diffs, logs, selected files)
        // ---------------------------------------------------------------
        {
            "label": "AI: Build context bundle",
            "type": "shell",
            "command": "${workspaceFolder:workspace}/tools/scripts/ai-context.sh --root ${workspaceFolder}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "pwsh",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder:workspace}\\tools\\scripts\\ai-context.ps1",
                    "-Root",
                    "${workspaceFolder}"
                ]
            }
        },

        // ---------------------------------------------------------------
        // Release: tag + upload PDF via GitHub CLI
        // ---------------------------------------------------------------
        {
            "label": "Release: Tag + Upload (GitHub)",
            "type": "shell",
            "command": "./scripts/release.sh && ${workspaceFolder:workspace}/tools/scripts/ai-context.sh --root ${workspaceFolder} && ${workspaceFolder:workspace}/tools/scripts/scrub.sh --root ${workspaceFolder}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "pwsh",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-Command",
                    "& 'scripts\\release.ps1'; & '${workspaceFolder:workspace}\\tools\\scripts\\ai-context.ps1' -Root '${workspaceFolder}'; & '${workspaceFolder:workspace}\\tools\\scripts\\scrub.ps1' -Root '${workspaceFolder}'"
                ]
            }
        },

        {
            "label": "latexmk (LuaLaTeX, externalized)",
            "type": "shell",
            "command": "latexmk -lualatex -shell-escape -halt-on-error -interaction=nonstopmode -file-line-error -pdf tex/main.tex",
            "group": "build",
            "problemMatcher": []
        }

    ]
}
