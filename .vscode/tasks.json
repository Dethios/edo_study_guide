{
  // ===================================================================
  // VS Code Tasks Configuration
  // ===================================================================
  "version": "2.0.0",
  "tasks": [
    // ---------------------------------------------------------------
    // Safe Git auto-push (runs ./scripts/push.sh)
    // ---------------------------------------------------------------
    {
      "label": "Git: Push (safe auto)",
      "type": "shell",
      "command": "./scripts/push.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts\\push.ps1"
        ]
      }
    },

    // ---------------------------------------------------------------
    // Scrub SAVE-ERROR/temp/lock artifacts
    // ---------------------------------------------------------------
    {
      "label": "Scrub temp artifacts",
      "type": "shell",
      "command": "./scripts/scrub.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts\\scrub.ps1"
        ]
      }
    },

    // ---------------------------------------------------------------
    // AI context bundle (diffs, logs, selected files)
    // ---------------------------------------------------------------
    {
      "label": "AI: Build context bundle",
      "type": "shell",
      "command": "./scripts/ai-context.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts\\ai-context.ps1"
        ]
      }
    },

    // ---------------------------------------------------------------
    // Release: tag + upload PDF via GitHub CLI
    // ---------------------------------------------------------------
    {
      "label": "Release: Tag + Upload (GitHub)",
      "type": "shell",
      "command": "./scripts/release.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts\\release.ps1"
        ]
      }
    },

    // ---------------------------------------------------------------
    // Settings merge (manual)
    // ---------------------------------------------------------------
    {
      "label": "Settings: Merge sources",
      "type": "shell",
      "command": "python3 ./scripts/settings_manager.py merge",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "scripts\\settings_manager.py",
          "merge"
        ]
      }
    },

    // ---------------------------------------------------------------
    // Auto pull when project is opened in VS Code
    // ---------------------------------------------------------------
    {
      "label": "Settings: Sync on Open",
      "type": "shell",
      "command": "python3 ./scripts/settings_manager.py sync",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent" },
      "runOptions": { "runOn": "folderOpen" },
      "windows": {
        "command": "py",
        "args": [
          "-3",
          "scripts\\settings_manager.py",
          "sync"
        ]
      }
    },

    // ---------------------------------------------------------------
    // Auto pull when project is opened in VS Code
    // ---------------------------------------------------------------
    {
      "label": "Git: Pull on Open",
      "type": "shell",
      "command": "git pull --ff-only",
      "presentation": { "reveal": "silent" },
      "runOptions": { "runOn": "folderOpen" }
    },
    // ---------------------------------------------------------------
    // Auto update WSL
    // ---------------------------------------------------------------
    {
      "label": "Update WSL on Open",
      "type": "shell",
      "command": "sudo /usr/bin/apt-get update && sudo /usr/bin/apt-get -y upgrade",
      "presentation": { "reveal": "silent" },
      "runOptions": { "runOn": "folderOpen" },
      "windows": { "command": "echo WSL update skipped on Windows." },
      "osx": { "command": "echo WSL update skipped on macOS." }
    }

  ]
}
