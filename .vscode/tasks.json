{
  // ===================================================================
  // VS Code Tasks Configuration
  // ===================================================================
  "version": "2.0.0",
  "tasks": [
    // ---------------------------------------------------------------
    // Safe Git auto-push (runs ./scripts/push.sh)
    // ---------------------------------------------------------------
    {
      "label": "Git: Push (safe auto)",
      "type": "shell",
      "command": "./scripts/push.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },

    // ---------------------------------------------------------------
    // Scrub SAVE-ERROR/temp/lock artifacts
    // ---------------------------------------------------------------
    {
      "label": "Scrub temp artifacts",
      "type": "shell",
      "command": "./scripts/scrub.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts\\scrub.ps1"
        ]
      }
    },

    // ---------------------------------------------------------------
    // AI context bundle (diffs, logs, selected files)
    // ---------------------------------------------------------------
    {
      "label": "AI: Build context bundle",
      "type": "shell",
      "command": "./scripts/ai-context.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts\\ai-context.ps1"
        ]
      }
    },

    // ---------------------------------------------------------------
    // Release: tag + upload PDF via GitHub CLI
    // ---------------------------------------------------------------
    {
      "label": "Release: Tag + Upload (GitHub)",
      "type": "shell",
      "command": "./scripts/release.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts\\release.ps1"
        ]
      }
    },

    // ---------------------------------------------------------------
    // Build an AI context zip (diff + log excerpt + selected files)
    // ---------------------------------------------------------------
    {
      "label": "AI: Build context zip",
      "type": "shell",
      "command": "./scripts/ai-context.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "windows": {
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts\\ai-context.ps1"
        ]
      }
    },

    // ---------------------------------------------------------------
    // Auto pull when project is opened in VS Code
    // ---------------------------------------------------------------
    {
      "label": "Git: Pull on Open",
      "type": "shell",
      "command": "git pull --ff-only",
      "presentation": { "reveal": "silent" },
      "runOptions": { "runOn": "folderOpen" }
    },
    // ---------------------------------------------------------------
    // Auto update WSL
    // ---------------------------------------------------------------
    {
      "label": "Update WSL on Open",
      "type": "shell",
      "command": "sudo /usr/bin/apt-get update && sudo /usr/bin/apt-get -y upgrade",
      "presentation": { "reveal": "silent" },
      "runOptions": { "runOn": "folderOpen" }
    }

  ]
}
