{
    // ===================================================================
    // VS Code Tasks Configuration
    // ===================================================================
    "version": "2.0.0",
    "tasks": [
        // ---------------------------------------------------------------
        // Safe Git auto-push and AI context bundle (project scripts)
        // ---------------------------------------------------------------
        {
            "label": "Git: Push (safe auto)",
            "type": "shell",
            "command": "./scripts/push.sh && ./scripts/ai-context.sh && ./scripts/scrub.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "pwsh",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-Command",
                    "& 'scripts\\push.ps1'; & 'scripts\\ai-context.ps1'; & 'scripts\\scrub.ps1'"
                ]
            }
        },

        // ---------------------------------------------------------------
        // Scrub SAVE-ERROR/temp/lock artifacts
        // ---------------------------------------------------------------
        {
            "label": "Scrub temp artifacts",
            "type": "shell",
            "command": "./scripts/scrub.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "pwsh",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "scripts\\scrub.ps1"
                ]
            }
        },

        // ---------------------------------------------------------------
        // AI context bundle (diffs, logs, selected files)
        // ---------------------------------------------------------------
        {
            "label": "AI: Build context bundle",
            "type": "shell",
            "command": "./scripts/ai-context.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "pwsh",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "scripts\\ai-context.ps1"
                ]
            }
        },

        // ---------------------------------------------------------------
        // Release: tag + upload PDF via GitHub CLI
        // ---------------------------------------------------------------
        {
            "label": "Release: Tag + Upload (GitHub)",
            "type": "shell",
            "command": "./scripts/release.sh && ./scripts/ai-context.sh && ./scripts/scrub.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "pwsh",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-Command",
                    "& 'scripts\\release.ps1'; & 'scripts\\ai-context.ps1'; & 'scripts\\scrub.ps1'"
                ]
            }
        },

        {
            "label": "latexmk (LuaLaTeX, externalized)",
            "type": "shell",
            "command": "latexmk -lualatex -shell-escape -halt-on-error -interaction=nonstopmode -file-line-error -pdf tex/main.tex",
            "group": "build",
            "problemMatcher": []
        }

    ]
}
