#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$repo_root" ]; then
  exit 0
fi

cd "$repo_root"

if command -v python3 >/dev/null 2>&1; then
  python_cmd=(python3)
elif command -v python >/dev/null 2>&1; then
  python_cmd=(python)
else
  echo "settings merge skipped: python not found" >&2
  exit 1
fi

"${python_cmd[@]}" scripts/settings_manager.py merge

if ! git diff --quiet -- settings_master.json; then
  echo "settings_master.json updated by merge. Please commit and push again." >&2
  exit 1
fi
