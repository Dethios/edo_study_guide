FROM miktex/miktex:essential

# Install runtime dependencies needed by this repo's build workflow:
# - perl: latexmk runtime
# - python3/python3-pygments: minted (Pygments lexer)
# - ghostscript/fontconfig: common PDF and font utilities
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        perl \
        python3 \
        python3-pygments \
        ghostscript \
        fontconfig \
    && rm -rf /var/lib/apt/lists/*

# Enable MiKTeX on-the-fly package installation for missing packages.
RUN initexmf --admin --set-config-value "[MPM]AutoInstall=1" \
    && initexmf --admin --update-fndb

# Preinstall frequently used package set generated from repo sources.
COPY miktex-packages.txt /tmp/miktex-packages.txt
RUN set -eu \
    && miktex packages update-package-database \
    && grep -Ev '^[[:space:]]*(#|$)' /tmp/miktex-packages.txt > /tmp/miktex-packages.clean \
    && if [ -s /tmp/miktex-packages.clean ]; then \
        xargs -a /tmp/miktex-packages.clean miktex packages install; \
    fi \
    && initexmf --admin --update-fndb
